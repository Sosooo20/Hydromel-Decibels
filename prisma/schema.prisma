generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum StandCategory {
  VENTES
  REPAS
}

enum EventType {
  CONCERT
  ACTIVITY
}

enum PoiCategory {
  STAGE
  FOOD
  DRINK
  SHOP
  TOILET
  ENTRANCE
  CAMPING
  INFO
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  username   String     @unique
  name       String?
  password   String
  role       Role       @default(USER)
  rank       String     @default("Apprenti Voyageur")
  pieceDor  Int        @default(0)
  festivals  Int        @default(0)
  createdAt  DateTime   @default(now())
  favorites  Favorite[]
}

model Stage {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  slug   String  @unique
  events Event[]
}

model Artist {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  name        String
  genre       String
  description String
  imageUrl    String?
  featured    Boolean @default(false)
  events      Event[]
}

model Event {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  type        EventType @default(CONCERT)
  description String
  imageUrl    String?
  day         String
  startTime   DateTime
  endTime     DateTime
  artistId    Int?
  artist      Artist?   @relation(fields: [artistId], references: [id])
  stageId     Int
  stage       Stage     @relation(fields: [stageId], references: [id])
  favorites   Favorite[]
}

model Favorite {
  id       Int     @id @default(autoincrement())
  userId   Int
  eventId  Int
  reminder Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model Stand {
  id          String        @id @default(cuid())
  name        String
  category    StandCategory
  description String?
  imageUrl    String?
  openTime    String?
  closeTime   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Activity {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  imageUrl    String?
  startTime   String?
  endTime     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PointOfInterest {
  id          Int         @id @default(autoincrement())
  name        String
  category    PoiCategory
  description String?
  imageUrl    String?
  lat         Float
  lng         Float
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}
